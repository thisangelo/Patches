#!/bin/sh
# ==============================================================================
# NAME:        fix_sof_reboot_pop
# DESCRIPTION: Unbinds the Intel SOF audio driver on system reboot to eliminate
#              DC Offset Pop / speaker electrical clicks.
# AUTHOR:      github@thisangelo
# ==============================================================================

# --- EXECUTION ---
if [ "$1" = "reboot" ]; then
    if [ -d "/sys/bus/pci/drivers/sof-audio-pci-intel-tgl" ]; then
        echo 0000:00:1f.3 > /sys/bus/pci/drivers/sof-audio-pci-intel-tgl/unbind 2>/dev/null || true
    fi
fi

# --- LOGIC & PARAMETERS ---
# "$1" = "reboot" : Ensures unbind triggers strictly during reboot, ignoring poweroff/halt.
# 0000:00:1f.3    : PCI bus address for the Intel HD Audio / SOF controller.
# unbind          : Safely detaches the PCI device before the kernel sends hard reset signal.

# --- INSTALLATION ---
# Target PATH: /usr/lib/systemd/system-shutdown/fix-sof-reboot.shutdown
# Commands:
# sudo install -m 755 ./fix_sof_reboot_pop /usr/lib/systemd/system-shutdown/fix-sof-reboot.shutdown

# --- VERIFICATION & INTEGRATION ---
# Systemd integration:
#   Automatically executed by systemd-shutdown daemon upon system reboot.
#
# Manual Test:
#   sudo systemctl reboot
#   (System should reboot without left-speaker electrical popping sound)

# --- OVERRIDES / ALTERNATIVES ---
# If using a different Intel platform (e.g., ADL / RPL / MTL):
#   Replace 'sof-audio-pci-intel-tgl' with your active SOF driver directory under /sys/bus/pci/drivers/
#
# Look your drivers and model laptop before execute this script.